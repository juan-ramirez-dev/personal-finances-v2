# Copia este archivo a .env.local. Valores locales salen de `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Solo si el proyecto firma con HS256 (Supabase local por defecto).
# Si está vacío se verifica con las llaves públicas (JWKS) del proyecto.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
